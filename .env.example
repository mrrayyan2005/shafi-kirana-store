# Copy to .env.local for local dev
# On Vercel: Project → Settings → Environment Variables (Production + Preview)

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster
MONGODB_DB=shafi_kirana

# JWT secret — long random string (used to sign login tokens)
JWT_SECRET=change-this-to-a-long-random-string
